    {
      "name": "constructor_standings",
      "displayName": "Clasificación por Temporada",
      "queryLines": [
        "SELECT\n",
        "  race_year,\n",
        "  constructor_id,\n",
        "  constructor_name,\n",
        "  total_points,\n",
        "  wins,\n",
        "  podiums,\n",
        "  season_rank\n",
        "FROM\n",
        "  gold.constructor_standings\n",
        "WHERE\n",
        "  season_rank <= 5\n",
        "  AND (\n",
        "    :year_from IS NULL\n",
        "    OR race_year >= :year_from\n",
        "  )\n",
        "  AND (\n",
        "    :year_to IS NULL\n",
        "    OR race_year <= :year_to\n",
        "  )\n",
        "  AND (\n",
        "    :selected_year IS NULL\n",
        "    OR race_year = :selected_year\n",
        "  )\n",
        "ORDER BY\n",
        "  total_points DESC"
      ],
      "parameters": [
        {
          "displayName": "Desde el Año",
          "keyword": "year_from",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "1950"
                }
              ]
            }
          }
        },
        {
          "displayName": "Hasta el Año",
          "keyword": "year_to",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "2030"
                }
              ]
            }
          }
        },
        {
          "displayName": "Temporada",
          "keyword": "selected_year",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "2024"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "season_champions",
      "displayName": "Campeones por Temporada",
      "queryLines": [
        "SELECT\n",
        "  race_year,\n",
        "  full_name,\n",
        "  champion_points\n",
        "FROM\n",
        "  gold.season_champions\n",
        "WHERE\n",
        "  (\n",
        "    :year_from IS NULL\n",
        "    OR race_year >= :year_from\n",
        "  )\n",
        "  AND (\n",
        "    :year_to IS NULL\n",
        "    OR race_year <= :year_to\n",
        "  )\n",
        "ORDER BY\n",
        "  race_year ASC"
      ],
      "parameters": [
        {
          "displayName": "Desde el Año",
          "keyword": "year_from",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "1950"
                }
              ]
            }
          }
        },
        {
          "displayName": "Hasta el Año",
          "keyword": "year_to",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "2030"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "constructor_dominance",
      "displayName": "Dinastías del Paddock",
      "queryLines": [
        "SELECT\n",
        "  constructor_id,\n",
        "  constructor_name,\n",
        "  streak_start_year,\n",
        "  streak_end_year,\n",
        "  streak_length,\n",
        "  CONCAT(\n",
        "    constructor_name,\n",
        "    ' (',\n",
        "    CAST(streak_start_year AS STRING),\n",
        "    '-',\n",
        "    CAST(streak_end_year AS STRING),\n",
        "    ')'\n",
        "  ) AS dynasty_label\n",
        "FROM\n",
        "  gold.constructor_dominance\n",
        "WHERE\n",
        "  (\n",
        "    :year_from IS NULL\n",
        "    OR streak_end_year >= :year_from\n",
        "  )\n",
        "  AND (\n",
        "    :year_to IS NULL\n",
        "    OR streak_start_year <= :year_to\n",
        "  )\n",
        "ORDER BY\n",
        "  streak_length DESC"
      ],
      "parameters": [
        {
          "displayName": "Desde el Año",
          "keyword": "year_from",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "1950"
                }
              ]
            }
          }
        },
        {
          "displayName": "Hasta el Año",
          "keyword": "year_to",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "2030"
                }
              ]
            }
          }
        }
      ]
    }
  ],
