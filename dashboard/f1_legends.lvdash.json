      "displayName": "Opciones de Año",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  race_year\n",
        "FROM\n",
        "  gold.season_champions\n",
        "ORDER BY\n",
        "  race_year"
      ]
    },
    {
      "name": "constructor_career",
      "displayName": "Top 10 Constructores — Carrera",
      "config": {
        "version": "1.1",
        "source": "SELECT constructor_id, constructor_name, nationality, total_points, total_wins,\n       total_podiums, first_season, last_season\nFROM gold.constructor_career ORDER BY total_wins DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "constructor_name",
            "expr": "constructor_name",
            "displayName": "Escudería"
          },
          {
